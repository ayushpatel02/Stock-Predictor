# Copy to .env and fill in values.
# Never commit .env to version control.

# Database — SQLite for local dev, Postgres for production
DATABASE_URL=sqlite:///./stock_predictor.db
# DATABASE_URL=postgresql://user:password@localhost:5432/stockpredictor

# Redis — optional, falls back to in-memory cache if not set
REDIS_URL=

# External API keys — all optional
FINNHUB_API_KEY=

# Model storage directory (relative to backend/)
MODELS_DIR=models

# Prediction signal thresholds
BUY_THRESHOLD=0.65
SELL_THRESHOLD=0.35

# Debug mode (enables SQL echo, verbose logging)
DEBUG=false
